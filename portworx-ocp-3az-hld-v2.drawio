fat"><mxGeometry x="1410" y="35" width="460" height="125" as="geometry"/></mxCell><mxCell id="fa3c0" value="&lt;b&gt;CT0&lt;/b&gt;&lt;br&gt;ETH4 (A) · ETH5 (B)" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;fillColor=#FFF3E0;strokeColor=#FE5000;fontSize=10;" vertex="1" parent="fa3"><mxGeometry x="15" y="30" width="120" height="44" as="geometry"/></mxCell><mxCell id="fa3c1" value="&lt;b&gt;CT1&lt;/b&gt;&lt;br&gt;ETH4 (A) · ETH5 (B)" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;fillColor=#FFF3E0;strokeColor=#FE5000;fontSize=10;" vertex="1" parent="fa3"><mxGeometry x="15" y="78" width="120" height="44" as="geometry"/></mxCell><mxCell id="fa3d" value="Witness only: 1 small LUN = PX KVDB metadata drive&lt;br&gt;Host object witness-0 · no data volumes&lt;br&gt;&lt;b&gt;CHAP (one-way)&lt;/b&gt;: host-user / host-password per host object" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="fa3"><mxGeometry x="145" y="28" width="305" height="90" as="geometry"/></mxCell><mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;fontStyle=1;endArrow=none;strokeColor=#1565C0;strokeWidth=3;exitX=0.5;exitY=1;entryX=0.239;entryY=0" edge="1" parent="1" source="fA3" target="fa3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;fontStyle=1;endArrow=none;strokeColor=#00897B;strokeWidth=3;exitX=0.5;exitY=1;entryX=0.761;entryY=0" edge="1" parent="1" source="fB3" target="fa3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="azn1" value="&lt;b&gt;dm-multipath&lt;/b&gt;: PURE stanza · ALUA · service-time 0 · 4 paths/LUN (2 fabrics × CT0/CT1)&lt;br&gt;&lt;b&gt;One-way CHAP&lt;/b&gt;: initiator → array only (no target secret)" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;labelBackgroundColor=#F7F9FC;fontSize=10;align=left;fontColor=#37474F;" vertex="1" parent="az1"><mxGeometry x="20" y="748" width="620" height="40" as="geometry"/></mxCell><mxCell id="azr1" value="Survives: loss of 1 worker, 1 fabric, 1 controller" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;labelBackgroundColor=#F7F9FC;fontSize=10;fontStyle=2;fontColor=#616161;" vertex="1" parent="az1"><mxGeometry x="20" y="835" width="620" height="24" as="geometry"/></mxCell><mxCell id="azn2" value="&lt;b&gt;dm-multipath&lt;/b&gt;: PURE stanza · ALUA · service-time 0 · 4 paths/LUN (2 fabrics × CT0/CT1)&lt;br&gt;&lt;b&gt;One-way CHAP&lt;/b&gt;: initiator → array only (no target secret)" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;labelBackgroundColor=#F7F9FC;fontSize=10;align=left;fontColor=#37474F;" vertex="1" parent="az2"><mxGeometry x="20" y="748" width="620" height="40" as="geometry"/></mxCell><mxCell id="azr2" value="Survives: loss of 1 worker, 1 fabric, 1 controller" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;labelBackgroundColor=#F7F9FC;fontSize=10;fontStyle=2;fontColor=#616161;" vertex="1" parent="az2"><mxGeometry x="20" y="835" width="620" height="24" as="geometry"/></mxCell><mxCell id="azn3" value="&lt;b&gt;One-way CHAP + multipath&lt;/b&gt; as in AZ1/AZ2&lt;br&gt;Only the witness KVDB LUN is presented" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;labelBackgroundColor=#F7F9FC;fontSize=10;align=left;fontColor=#37474F;" vertex="1" parent="az3"><mxGeometry x="20" y="748" width="480" height="40" as="geometry"/></mxCell><mxCell id="azr3" value="Loss of AZ3: etcd 2/3 ✔ · PX quorum 2/3 ✔ · no I/O impact" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;labelBackgroundColor=#F7F9FC;fontSize=10;fontStyle=2;fontColor=#616161;" vertex="1" parent="az3"><mxGeometry x="20" y="835" width="480" height="24" as="geometry"/></mxCell><mxCell id="mgmt" value="Portworx → FlashArray REST API (HTTPS 443, pure.json token) over the management network: create, connect and resize cloud drives on the FA of the node’s own zone" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;labelBackgroundColor=#F7F9FC;fontSize=10;fontColor=#546E7A;fontStyle=2;" vertex="1" parent="cluster"><mxGeometry x="40" y="832" width="1840" height="22" as="geometry"/></mxCell><mxCell id="leg" value="&lt;b&gt;Legend&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#9E9E9E;verticalAlign=top;align=left;spacingLeft=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="1205" width="600" height="200" as="geometry"/></mxCell><mxCell id="lg_i" value="OCP" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;ellipse;fillColor=#FFFFFF;strokeColor=#CC0000;strokeWidth=4;fontColor=#CC0000;fontStyle=1;fontSize=9;strokeWidth=3;fontSize=8;" vertex="1" parent="1"><mxGeometry x="58" y="1235" width="30" height="30" as="geometry"/></mxCell><mxCell id="lg_it" value="OpenShift node (control plane / worker)" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="95" y="1238" width="220" height="24" as="geometry"/></mxCell><mxCell id="lg_p" value="▶ portworx" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=30;fillColor=#FFF3E0;strokeColor=#F26722;strokeWidth=1.5;fontColor=#BF360C;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="340" y="1238" width="90" height="24" as="geometry"/></mxCell><mxCell id="lg_pt" value="Portworx (storage / witness)" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="438" y="1238" width="190" height="24" as="geometry"/></mxCell><mxCell id="lg18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;fontStyle=1;endArrow=none;strokeColor=#1565C0;strokeWidth=3" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="58" y="1283" as="sourcePoint"/><mxPoint x="128" y="1283" as="targetPoint"/></mxGeometry></mxCell><mxCell id="lgt0" value="iSCSI Fabric A (TCP 3260, multipath, one-way CHAP)" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="140" y="1272" width="490" height="22" as="geometry"/></mxCell><mxCell id="lg19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;fontStyle=1;endArrow=none;strokeColor=#00897B;strokeWidth=3" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="58" y="1307" as="sourcePoint"/><mxPoint x="128" y="1307" as="targetPoint"/></mxGeometry></mxCell><mxCell id="lgt1" value="iSCSI Fabric B (TCP 3260, multipath, one-way CHAP)" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="140" y="1296" width="490" height="22" as="geometry"/></mxCell><mxCell id="lg20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;fontStyle=1;startArrow=none;endArrow=none;startFill=1;endFill=1;strokeColor=#F26722;strokeWidth=5" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="58" y="1331" as="sourcePoint"/><mxPoint x="128" y="1331" as="targetPoint"/></mxGeometry></mxCell><mxCell id="lgt2" value="Portworx synchronous replication AZ1 ↔ AZ2 (repl=2)" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="140" y="1320" width="490" height="22" as="geometry"/></mxCell><mxCell id="lg21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;fontStyle=1;endArrow=none;strokeColor=#8E24AA;strokeWidth=2.5;dashed=1;dashPattern=4 4" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="58" y="1355" as="sourcePoint"/><mxPoint x="128" y="1355" as="targetPoint"/></mxGeometry></mxCell><mxCell id="lgt3" value="Portworx witness / cluster communication (quorum, KVDB)" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="140" y="1344" width="490" height="22" as="geometry"/></mxCell><mxCell id="lg22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;fontStyle=1;endArrow=none;strokeColor=#CC0000;strokeWidth=2;dashed=1;dashPattern=8 4" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="58" y="1379" as="sourcePoint"/><mxPoint x="128" y="1379" as="targetPoint"/></mxGeometry></mxCell><mxCell id="lgt4" value="OpenShift control plane (etcd peer, multi-AZ)" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="140" y="1368" width="490" height="22" as="geometry"/></mxCell><mxCell id="chap" value="&lt;b&gt;iSCSI / CHAP detail&lt;/b&gt;&lt;br&gt;• &lt;b&gt;One-way CHAP&lt;/b&gt;: the FlashArray authenticates each initiator; hosts do not authenticate the array&lt;br&gt;• Purity: &lt;i&gt;host-user / host-password&lt;/i&gt; on each host object; no target-user/password&lt;br&gt;• RHCOS: iscsid.conf &lt;i&gt;node.session.auth.authmethod=CHAP&lt;/i&gt;, username/password via MachineConfig&lt;br&gt;• 2 dedicated NICs per node, one per fabric; each fabric reaches CT0 + CT1 → 4 active paths per LUN&lt;br&gt;• Each node only sees LUNs from the FlashArray in its own AZ" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#9E9E9E;dashed=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;dashed=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="660" y="1205" width="620" height="200" as="geometry"/></mxCell><mxCell id="kp" value="&lt;b&gt;Key Points&lt;/b&gt;&lt;br&gt;• 3 AZs; 1 master per AZ, etcd survives loss of any one AZ&lt;br&gt;• AZ1 &amp;amp; AZ2: 6 workers each, Portworx storage nodes on FlashArray cloud drives&lt;br&gt;• Portworx replicates every volume across AZ1 and AZ2 (repl=2), so a data AZ or an entire array can be lost without data loss&lt;br&gt;• AZ3: master-3 + Portworx witness only, no app workloads; FA-AZ3 holds only the witness KVDB drive&lt;br&gt;• Inter-AZ RTT &amp;lt; 10 ms required (etcd + sync replication)&lt;br&gt;• &lt;i&gt;Assumption: FA-AZ3 role, KVDB on dedicated drive&lt;/i&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#9E9E9E;dashed=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;dashed=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1300" y="1205" width="660" height="200" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>